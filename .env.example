# Local development only. Copy to .env and replace every change-me value.
COMMERCE_HOST=commerce.local
HTTPS_PORT=8443

POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=change-me-local-postgres
REDIS_PASSWORD=change-me-local-redis

# Authentication is local development only. Replace every change-me value in .env.
# Access tokens expire after exactly 60 seconds; refresh tokens are opaque and rotated.
JWT_ISSUER=commerce-local
JWT_AUDIENCE=commerce-ios
JWT_SIGNING_KEY=change-me-local-jwt-signing-key-please-replace-32-chars-min
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=change-me-local-seed-password-123

POSTGRES_IMAGE=postgres:18.4-alpine
REDIS_IMAGE=redis:8.2-alpine
KAFKA_IMAGE=apache/kafka:4.3.1
CADDY_IMAGE=caddy:2.10.0-alpine
API_IMAGE=commerce-api:local

# Local SonarQube Compose stack. Copy to .env and replace the password.
SONAR_PORT=9000
SONAR_POSTGRES_DB=sonarqube
SONAR_POSTGRES_USER=sonarqube
SONAR_POSTGRES_PASSWORD=change-me-local-sonarqube-postgres
